<?xml version="1.0" encoding="utf-8"?>
<!--
  Tailor's outfit stand: unpowered, unlocked by vanilla Complex Clothing, mended by Tailoring colonists.
  Derives from OutfitStandBase (Odyssey's, or the NoOdyssey copy), so it needs no Odyssey content. The list overrides use
  Inherit="False" because the base lists Stony stuff and Complex Furniture research that this stand does not want.
-->
<Defs>
    <ThingDef ParentName="OutfitStandBase" Name="OutfitStandsPlusForked_TailorOutfitStandBase" Abstract="True">
        <description>A small display that showcases a single outfit. Saves space and can be used to quickly change clothing.\nColonists who do tailoring mend the cloth and leather clothes kept on it, using a little cloth or leather as they work. No power needed.</description>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,1)</interactionCellOffset>
        <stuffCategories Inherit="False">
            <li>Woody</li>
            <li>Metallic</li>
        </stuffCategories>
        <costList>
            <Cloth>10</Cloth>
        </costList>
        <costStuffCount>50</costStuffCount>
        <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
        <statBases>
            <WorkToBuild>1000</WorkToBuild>
        </statBases>
        <comps>
            <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedMainComp">
            </li>
            <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedStandComp">
            </li>
            <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_TailorMending">
            </li>
        </comps>
        <researchPrerequisites Inherit="False">
            <li>ComplexClothing</li>
        </researchPrerequisites>
    </ThingDef>
    <ThingDef ParentName="OutfitStandsPlusForked_TailorOutfitStandBase">
        <label>tailor's outfit stand</label>
        <defName>OutfitStandsPlus_TailorOutfitStand</defName>
        <thingClass>OutfitStandsPlusForked.Things.TailorOutfitStand</thingClass>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <texPath>Things/Building/OutfitStand/TailorOutfitStand_MenuIcon</texPath>
            <drawSize>(1.3, 1.3)</drawSize>
        </graphicData>
        <building>
            <storageGroupTag>OutfitStand</storageGroupTag>
            <fixedStorageSettings>
                <filter>
                    <specialFiltersToDisallow>
                        <li>AllowChildOnlyApparel</li>
                    </specialFiltersToDisallow>
                </filter>
            </fixedStorageSettings>
        </building>
        <comps>
            <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_AssignableToPawn_OutfitStandsPlusForkedAdult">
            </li>
        </comps>
    </ThingDef>
    <!-- Needs Biotech, unlike the mechanized and mending kid stands, which load without it. -->
    <ThingDef ParentName="OutfitStandsPlusForked_TailorOutfitStandBase" MayRequire="Ludeon.RimWorld.Biotech">
        <label>tailor's kid outfit stand</label>
        <defName>OutfitStandsPlus_TailorKidOutfitStand</defName>
        <thingClass>OutfitStandsPlusForked.Things.TailorKidOutfitStand</thingClass>
        <costList>
            <Cloth>8</Cloth>
        </costList>
        <costStuffCount>40</costStuffCount>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <texPath>Things/Building/OutfitStand/TailorKidOutfitStand_MenuIcon</texPath>
            <drawSize>(1.3, 1.3)</drawSize>
        </graphicData>
        <building>
            <storageGroupTag>KidOutfitStand</storageGroupTag>
            <fixedStorageSettings>
                <filter>
                    <specialFiltersToDisallow>
                        <li>AllowAdultOnlyApparel</li>
                    </specialFiltersToDisallow>
                </filter>
            </fixedStorageSettings>
        </building>
        <comps>
            <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_AssignableToPawn_OutfitStandsPlusForkedKid">
            </li>
        </comps>
    </ThingDef>
</Defs>
