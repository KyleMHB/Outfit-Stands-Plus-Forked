<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="OutfitStandBase" Name="OutfitStandsPlusForked_MendingOutfitStandBase" Abstract="True">
        <description>A small display that showcases a single outfit. Saves space and can be used to quickly change clothing.\nMechanized for extra changing speed and uses mechanites to repair stored items.</description>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,1)</interactionCellOffset>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costList>
            <Steel>40</Steel>
            <ComponentIndustrial>4</ComponentIndustrial>
            <ComponentSpacer>2</ComponentSpacer>
        </costList>
        <costStuffCount>80</costStuffCount>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
        <statBases>
            <WorkToBuild>5000</WorkToBuild>
        </statBases>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>150</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedMainComp">
            </li>
            <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedStandComp">
            </li>
        </comps>
        <tickerType>Rare</tickerType>
        <researchPrerequisites>
            <li>OutfitStandsPlus_MendingOutfitStandsResearch</li>
        </researchPrerequisites>
    </ThingDef>
    <ThingDef ParentName="OutfitStandsPlusForked_MendingOutfitStandBase">
        <label>mending outfit stand</label>
        <defName>OutfitStandsPlus_MendingOutfitStand</defName>
        <thingClass>OutfitStandsPlusForked.Things.MendingOutfitStand</thingClass>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <texPath>Things/Building/OutfitStand/OutfitStand_MenuIcon</texPath>
            <drawSize>(1.3, 1.3)</drawSize>
        </graphicData>
        <building>
            <storageGroupTag>OutfitStand</storageGroupTag>
            <fixedStorageSettings>
                <filter>
                    <specialFiltersToDisallow>
                        <li>AllowChildOnlyApparel</li>
                    </specialFiltersToDisallow>
                </filter>
            </fixedStorageSettings>
        </building>
        <comps>
            <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_AssignableToPawn_OutfitStandsPlusForkedAdult">
            </li>
        </comps>
    </ThingDef>
    <ThingDef ParentName="OutfitStandsPlusForked_MendingOutfitStandBase">
        <label>mending kid outfit stand</label>
        <defName>OutfitStandsPlus_MendingKidOutfitStand</defName>
        <thingClass>OutfitStandsPlusForked.Things.MendingKidOutfitStand</thingClass>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <texPath>Things/Building/OutfitStand/KidOutfitStand_MenuIcon</texPath>
            <drawSize>(1.3, 1.3)</drawSize>
        </graphicData>
        <building>
            <storageGroupTag>KidOutfitStand</storageGroupTag>
            <fixedStorageSettings>
                <filter>
                    <specialFiltersToDisallow>
                        <li>AllowAdultOnlyApparel</li>
                    </specialFiltersToDisallow>
                </filter>
            </fixedStorageSettings>
        </building>
        <comps>
            <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_AssignableToPawn_OutfitStandsPlusForkedKid">
            </li>
        </comps>
    </ThingDef>
</Defs>
