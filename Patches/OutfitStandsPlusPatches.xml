<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="Building_OutfitStand"]/comps</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="Building_OutfitStand"]</xpath>
            <value>
                <comps>
                    <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_AssignableToPawn_OutfitStandsPlusForkedAdult">
                    </li>
                    <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedMainComp"></li>
                    <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedStandComp"></li>
                </comps>
            </value>
        </nomatch>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[defName="Building_OutfitStand"]/comps</xpath>
            <value>
                <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_AssignableToPawn_OutfitStandsPlusForkedAdult">
                </li>
                <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedMainComp"></li>
                <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedStandComp"></li>
            </value>
        </match>
    </Operation>
    <!-- The vanilla kid stand only exists with Biotech; skip quietly when it is absent. -->
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="Building_KidOutfitStand"]</xpath>
        <match Class="PatchOperationConditional">
            <xpath>/Defs/ThingDef[defName="Building_KidOutfitStand"]/comps</xpath>
            <nomatch Class="PatchOperationAdd">
                <xpath>/Defs/ThingDef[defName="Building_KidOutfitStand"]</xpath>
                <value>
                    <comps>
                        <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_AssignableToPawn_OutfitStandsPlusForkedKid">
                        </li>
                        <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedMainComp"></li>
                        <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedStandComp"></li>
                    </comps>
                </value>
            </nomatch>
            <match Class="PatchOperationAdd">
                <xpath>/Defs/ThingDef[defName="Building_KidOutfitStand"]/comps</xpath>
                <value>
                    <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_AssignableToPawn_OutfitStandsPlusForkedKid">
                    </li>
                    <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedMainComp"></li>
                    <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedStandComp"></li>
                </value>
            </match>
        </match>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[@Name="BasePawn"]/comps</xpath>
        <value>
        <li Class="OutfitStandsPlusForked.ThingComps.CompProperties_OutfitStandsPlusForkedUseCommandsComp">
        </li>
        </value>
    </Operation>
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[@Name="OutfitStandBase"]/minifiedDef[@IsNull="True"]</xpath>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/ThingDef[@Name="OutfitStandBase"]</xpath>
            <value>
                <minifiedDef>OutfitStandPlusMinified</minifiedDef>
                <thingCategories>
                    <li>BuildingsFurniture</li>
                </thingCategories>
            </value>
        </match>
    </Operation>
</Patch>
